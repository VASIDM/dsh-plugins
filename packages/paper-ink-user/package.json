{
  "name": "@local/paper-ink-user",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "纸墨 · 用户：侧栏底部的本地账户卡，空头像可上传、名称自动回退系统用户名、手机号可填。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
