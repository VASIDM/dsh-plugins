{
  "name": "@local/paper-ink-type",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Song serif for prose, monospace kept for code, serif brand wordmark. One of the five Paper & Ink layers; enable it alone or alongside the others.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
