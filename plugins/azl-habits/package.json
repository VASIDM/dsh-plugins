{
  "name": "@local/azl-habits",
  "version": "1.0.8",
  "private": true,
  "description": "Habit memory that turns recurring preferences from every conversation into a standing preset, plus an Azur Lane Live2D skin viewer.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./l2d": "./l2d.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "l2d.js",
    "client.js",
    "cordis.patch.yml",
    "cordis.patch.l2d.yml",
    "locale/*.json",
    "icon.svg",
    "icon-l2d.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
